# ==========================================
# KONFIGURASI ENVIRONMENT KANTOR AI BACKEND
# (Gunakan variabel ini di Dashboard Railway)
# ==========================================

# Port Server (Di Railway otomatis diset oleh sistem Railway, default: 3000)
PORT=3000

# Database PostgreSQL (Otomatis disediakan jika menambahkan database PostgreSQL di Railway)
DATABASE_URL="postgresql://postgres:password@postgres.railway.internal:5432/railway"

# Redis Server (Otomatis disediakan jika menambahkan database Redis di Railway)
# Bisa menggunakan REDIS_URL langsung atau host terpisah:
REDIS_URL="redis://default:password@redis.railway.internal:6379"
# Atau alternatif:
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Konfigurasi LLM AI Router (OpenRouter / OpenAI / Gateway yang dapat diakses publik dari cloud)
ROUTER_BASE_URL="https://openrouter.ai/api/v1"
ROUTER_API_KEY="sk-or-v1-xxxxxxxxxxxxxxxx"
ROUTER_MODEL="google/gemini-2.5-flash"
